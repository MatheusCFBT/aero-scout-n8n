{
  "id": "AeroScoutTelegramDelivery",
  "name": "Aero Scout — enviar listas",
  "nodes": [
    {
      "id": "delivery-1",
      "name": "Receber mensagens",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "delivery-2",
      "name": "Somente prévia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dry-run",
              "leftValue": "={{ $json.dryRun }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "delivery-3",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        160
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true,
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "delivery-4",
      "name": "Registrar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        160
      ],
      "parameters": {
        "jsCode": "// Generated from src/n8n/verifyDelivery. Edit the source, then run npm run build.\n\nreturn (function execute({ input, nodes }) {\n  const results = input.all().map((item, index) => ({\n    json: {\n      category: nodes.messages.itemMatching(index).json.category,\n      sent: !item.json.error,\n      error: item.json.error ? \"Falha de envio no Telegram\" : null,\n    },\n    pairedItem: { item: index },\n  }));\n  if (results.some((item) => !item.json.sent)) {\n    throw Error(\n      \"Uma ou mais mensagens não foram entregues. \" +\n      \"Consulte Registrar envio antes de repetir para evitar duplicatas.\",\n    );\n  }\n  return results;\n})({ input: $input, now: $now, nodes: { messages: $(\"Receber mensagens\") } }, {  });\n"
      }
    }
  ],
  "connections": {
    "Receber mensagens": {
      "main": [
        [
          {
            "node": "Somente prévia?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Somente prévia?": {
      "main": [
        null,
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram": {
      "main": [
        [
          {
            "node": "Registrar envio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo",
    "executionTimeout": 1200,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "tags": []
}
